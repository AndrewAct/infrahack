# Copy to .env and fill in real values. .env is gitignored; this template is not.
#
# The app runs with NO database by default (in-memory repo). Set DB_URL to switch
# to Supabase Postgres. Leave it unset/blank to stay in-memory.
#
# Supabase transaction pooler (Project Settings -> Database -> Connection pooling).
# Keep this as the pooler URL; do not switch app code to the direct connection.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-db-password>

# Max Postgres connections this instance may hold open (backpressure bound).
DB_POOL_MAX=10

# HTTP server port.
SERVER_PORT=8080
