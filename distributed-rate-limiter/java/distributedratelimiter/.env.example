# Copy to .env and fill in real values. .env is gitignored; this template is not.
#
# The app runs with NO external dependencies by default: in-memory sample rate limit rules and a
# single-JVM token bucket store. Set DB_URL and/or REDIS_URL below to switch each on independently.

# --- Rules (control plane) ---
# Set to use Postgres for dynamic rule configuration. Leave unset to use the built-in sample rules
# in InMemoryRateLimitRuleRepository (fixed until restart; see db/schema.sql + db/seed.sql).
#
# Supabase transaction pooler (Project Settings -> Database -> Connection pooling).
# prepareThreshold=0 is required: the transaction pooler cannot host server-side named prepared
# statements, so pgjdbc must stay on unnamed statements.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-supabase-db-password>
DB_POOL_MAX=10

# --- Token buckets (data plane) ---
# Set to use Redis for distributed, cross-instance counters. Leave unset to use a single-JVM
# in-memory store instead (NOT distributed - local development only).
# See java/distributedratelimiter/README.md for local Redis setup instructions.
REDIS_URL=redis://localhost:6379

# --- Behavior ---
# What to do when the token bucket store (or, at rule-refresh time, Postgres) is unreachable.
# ALLOW = fail open (default); DENY = fail closed. Individual rules may override this via their
# own failure_policy column/field.
RATE_LIMITER_DEFAULT_FAILURE_POLICY=ALLOW

# How often (ms) each instance polls Postgres for rule changes.
RATE_LIMITER_RULE_REFRESH_INTERVAL_MS=10000

# HTTP server port.
SERVER_PORT=8080
