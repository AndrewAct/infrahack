# Postgres connection string (Supabase: Settings -> Database -> Connection string -> URI).
# Use a SESSION-mode endpoint (direct or Session Pooler), NOT the transaction pooler:
# leader election (advisory lock) and the node agent both need session connections.
# The Supabase service-role key is NOT the database password.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Background scheduler (tick + reap). Safe to leave on for every replica: an advisory
# lock makes exactly one process the active leader.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=1.0

# A node is presumed dead (its runs rescheduled) after this much heartbeat silence.
NODE_HEARTBEAT_TIMEOUT_SECONDS=15.0

# Retry backoff: delay = min(base * 2^(attempt-1), cap) * jitter.
RETRY_BASE_SECONDS=2.0
RETRY_CAP_SECONDS=300.0
