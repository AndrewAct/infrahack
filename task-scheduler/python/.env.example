# Postgres connection string the app connects to directly (psycopg).
# Supabase: Dashboard -> Settings -> Database -> Connection string -> URI.
# Use the session pooler (5432) or transaction pooler (6543). The SUPABASE
# service-role / secret key is NOT the database password.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Background scheduler loop (tick + reaper). Disable to drive it only via /admin/tick.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=1

# Retry backoff: delay = min(base * 2^(attempt-1), cap) * jitter, in seconds.
RETRY_BASE_SECONDS=2
RETRY_CAP_SECONDS=300
