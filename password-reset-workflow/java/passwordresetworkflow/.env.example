# Copy to .env and fill in real values. .env is gitignored; this template is not.
#
# The app runs with NO database by default (in-memory user repository, demo user seeded).
# Set DB_URL to switch user persistence to Supabase Postgres. Leave it unset/blank to
# stay in-memory. Reset codes are always in-process (30s lifetime; see README).
#
# Supabase transaction pooler (Project Settings -> Database -> Connection pooling).
# prepareThreshold=0 is required: the transaction pooler cannot host server-side named
# prepared statements, so pgjdbc must stay on unnamed statements.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USER=postgres.hxrzvagsvzmsgxmrjjji
DB_PASSWORD=<your-supabase-db-password>

# Max Postgres connections this instance may hold open (backpressure bound).
DB_POOL_MAX=10

# HTTP server port.
SERVER_PORT=8080
